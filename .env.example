# Supabase session-pooler URL for the restricted crawler role (see sarkari-web README):
# postgres://sarkari_crawler.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SARKARI_DATABASE_URL=

# Primary first, fallbacks after, comma-separated. Free tiers only.
# Groq: https://console.groq.com/docs/models. OpenRouter free models: https://openrouter.ai/models?max_price=0
# (check a free GPT-OSS-120B id exists there before adding it, e.g. openrouter:openai/gpt-oss-120b:free)
SARKARI_EXTRACTORS=groq:openai/gpt-oss-120b

GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: daily report to Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
